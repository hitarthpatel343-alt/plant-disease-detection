        "plant": "Apple",
        "disease": "Apple Scab",
        "scientific_name": "Venturia inaequalis",
        "symptoms": [
            "Olive-green to dark spots may appear on leaves.",
            "Severe infection can distort leaves and cause corky or cracked fruit lesions."
        ],
        "disease_development": "The pathogen can survive in infected fallen leaves. Spores may infect new growth under suitable wet conditions.",
        "management": [
            "Collect and appropriately dispose of infected fallen leaves.",
            "Improve airflow where practical.",
            "Use locally approved control measures with advice from an agricultural expert."
        ],
        "prevention": [
            "Maintain orchard sanitation.",
            "Monitor leaves and fruit.",
            "Reduce prolonged leaf wetness where practical."
        ],
